#!/usr/bin/env bash
set -u

GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
ok(){ echo -e "${GREEN}[ OK ]${NC} $*"; }
fail(){ echo -e "${RED}[FAIL]${NC} $*"; }
warn(){ echo -e "${YELLOW}[WARN]${NC} $*"; }
section(){ echo -e "\n${BLUE}$*${NC}\n$(printf -- '-%.0s' $(seq 1 ${#1}))"; }

echo "Reverse Proxy Health Check"
echo "=========================="

section "System"
[[ -r /etc/os-release ]] && . /etc/os-release && ok "${PRETTY_NAME:-Linux}"
UP="$(uptime -p 2>/dev/null || true)"; [[ -n "$UP" ]] && ok "$UP"
DISK="$(df -P / | awk 'NR==2 {print $5}')"; ok "Root filesystem usage: $DISK"
MEM="$(free -m | awk '/^Mem:/ {print $3 " / " $2 " MB"}')"; ok "Memory: $MEM"

section "NGINX"
systemctl is-active --quiet nginx && ok "Service: running" || fail "Service: not running"
nginx -t >/dev/null 2>&1 && ok "Configuration: valid" || fail "Configuration: invalid"
ss -lnt | awk '{print $4}' | grep -Eq '(^|:|\])80$' && ok "HTTP/80: listening" || warn "HTTP/80: not listening"
ss -lnt | awk '{print $4}' | grep -Eq '(^|:|\])443$' && ok "HTTPS/443: listening" || warn "HTTPS/443: not listening"

section "Security"
if systemctl is-enabled --quiet nftables 2>/dev/null; then
    systemctl is-active --quiet nftables && ok "nftables: active" || fail "nftables: enabled but inactive"
else
    warn "nftables: not enabled"
fi
systemctl is-active --quiet fail2ban && ok "Fail2ban: active" || fail "Fail2ban: not running"
if command -v fail2ban-client >/dev/null 2>&1; then
    JAILS="$(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:[[:space:]]*//p')"
    [[ -n "$JAILS" ]] && ok "Fail2ban jails: $JAILS"
fi

section "Certificates"
if systemctl list-unit-files certbot.timer >/dev/null 2>&1; then
    systemctl is-enabled --quiet certbot.timer && ok "Certbot timer: enabled" || warn "Certbot timer: disabled"
fi
shopt -s nullglob
CERTS=(/etc/letsencrypt/live/*/cert.pem)
if ((${#CERTS[@]} == 0)); then
    warn "No Let's Encrypt certificates installed."
else
    for cert in "${CERTS[@]}"; do
        domain="$(basename "$(dirname "$cert")")"
        end="$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)"
        if [[ -n "$end" ]]; then
            end_epoch="$(date -d "$end" +%s)"
            now="$(date +%s)"
            days=$(( (end_epoch-now) / 86400 ))
            (( days >= 21 )) && ok "$domain: ${days} days remaining" || warn "$domain: ${days} days remaining"
        fi
    done
fi

section "Connectivity"
getent ahostsv4 deb.debian.org >/dev/null 2>&1 && ok "DNS resolution: working" || fail "DNS resolution: failed"

echo

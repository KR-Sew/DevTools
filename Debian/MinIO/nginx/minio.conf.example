# MinIO S3 API
server {
    listen your_ip_address_here:80;
    server_name s3.your_domain_name.com;

    return 301 https://$host$request_uri;
}

server {
    listen your_ip_address_here:443 ssl http2;
    server_name your_domain_name.com;

    ssl_certificate /etc/letsencrypt/live/s3.your_domain_name.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/s3.your_domain_name.com/privkey.pem;

    client_max_body_size 0;

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_buffering off;
        proxy_request_buffering off;

        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
    }
}

# MinIO Web Console
server {
    listen our_ip_address_here;
    server_name s3-console.your_domain_name.com;

    return 301 https://$host$request_uri;
}

server {
    listen our_ip_address_here:443 ssl http2;
    server_name s3-console.your_domain_name.com;

    ssl_certificate /etc/letsencrypt/live/s3.your_domain_name.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/s3.your_domain_name.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:9001;
        proxy_http_version 1.1;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
    }
}
